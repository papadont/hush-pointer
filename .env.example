VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
# Optional:
# VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

VITE_FIREBASE_APPCHECK_SITE_KEY=your_recaptcha_v3_site_key
# Optional for local debugging only:
# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=true

# AI Coach (OpenAI)
# Note: Vite env vars are embedded in client bundle. For production, prefer server-side proxy.
# VITE_OPENAI_API_KEY=your_openai_api_key
# VITE_OPENAI_MODEL=gpt-4.1-mini
# VITE_OPENAI_BASE_URL=https://api.openai.com/v1
